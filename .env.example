# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Geheim! Nur auf dem Server (Cron, Kalender-Abo)
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
# optional, Standard: claude-haiku-5-5
ANTHROPIC_MODEL=

# --- Push (npm run vapid erzeugt die Schlüssel) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# --- Cron-Schutz (beliebiger langer Zufallswert) ---
CRON_SECRET=

# --- E-Mail (optional, resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Vouchy <onboarding@resend.dev>

# --- Öffentliche Adresse der App (für Links in Mails/Kalender) ---
NEXT_PUBLIC_APP_URL=https://vouchy.vercel.app
