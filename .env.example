# --- Datenbank ---
# Wird von Vercel automatisch gesetzt, wenn du unter "Storage" Neon hinzufügst.
DATABASE_URL=

# --- Bilderkennung (Pflicht) ---
# Kostenlos: aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# optional, Standard: gemini-flash-latest
GEMINI_MODEL=

# --- E-Mail-Erinnerungen über Gmail (optional) ---
# App-Passwort: myaccount.google.com/apppasswords (2-Faktor muss aktiv sein)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Alles weitere ist optional ---
# Push-Schlüssel erzeugt die App beim ersten Start selbst.
# CRON_SECRET schützt den täglichen Erinnerungs-Job (beliebiger Zufallswert).
CRON_SECRET=
